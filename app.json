{
  "expo": {
    "name": "Tripvisor",
    "slug": "tripvisor",
    "scheme": "tripvisor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripvisor.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tripvisor uses your location to show where you are on the map and to build a route from your current location to the first place on your itinerary.",
        "NSPhotoLibraryUsageDescription": "Tripvisor lets you pick photos from your library to add them to your trip memories. Photos stay private unless you share them with your trip."
      }
    },
    "android": {
      "package": "com.tripvisor.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C8578"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Tripvisor uses your location to show where you are on the map and to build a route from your current location to the first place on your itinerary."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "tr"
          ],
          "allowDynamicLocaleChangesAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tripvisor lets you pick photos from your library to add them to your trip memories. Photos stay private unless you share them with your trip.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "@sentry/react-native",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C8578",
          "dark": {
            "image": "./assets/images/adaptive-icon.png",
            "backgroundColor": "#0A6A5F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon-1024.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "locales": {
      "tr": "./assets/locales/tr.json"
    }
  }
}
