{
  "expo": {
    "name": "Tripvisor",
    "slug": "tripvisor",
    "scheme": "tripvisor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripvisor.app",
      "config": {
        "googleMapsApiKey": "REPLACE_WITH_IOS_MAPS_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tripvisor uses your location to show where you are on the map and to build a route from your current location to the first place on your itinerary."
      }
    },
    "android": {
      "package": "com.tripvisor.app",
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_MAPS_KEY"
        }
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-secure-store",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
