# Edge Function secrets — local development only.
# Copy this file to supabase/functions/.env and fill in values.
# DO NOT commit supabase/functions/.env to git — it's already in .gitignore.

# Google Maps Platform — server-side key (no referrer restriction)
# See docs/google-maps-setup.md for how to obtain.
# Required even when ORS is the primary router — it backs the automatic
# failover in distance-matrix / directions-polyline.
GOOGLE_MAPS_SERVER_KEY=

# v2 N5 — routing provider (D2: openrouteservice primary, Google fallback).
# Free key: https://openrouteservice.org (~2k directions + 500 matrix req/day).
# Leave both unset for the default all-Google behavior. The app_config row
# ('routing_provider') overrides ROUTING_PROVIDER at runtime — see
# supabase/migrations/README-v2.md for the ops runbook.
# ORS_API_KEY=
# ROUTING_PROVIDER=ors

# Optional: Sentry DSN for Edge Function error tracking
# SENTRY_DSN=
