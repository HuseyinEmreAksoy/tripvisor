{
  "name": "tripvisor",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:web": "expo export --platform web",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "smoke": "playwright test --reporter=list",
    "deploy:db": "supabase db push --linked",
    "deploy:functions": "supabase functions deploy places-autocomplete && supabase functions deploy place-details && supabase functions deploy place-photo --no-verify-jwt && supabase functions deploy distance-matrix && supabase functions deploy directions-polyline && supabase functions deploy optimize-trip && supabase functions deploy manage-collaborators && supabase functions deploy share-trip && supabase functions deploy delete-account && supabase functions deploy export-account",
    "deploy:web:preview": "npm run build:web && echo \"Web bundle built at dist/. Cloudflare Pages will deploy on push to master.\"",
    "deploy:android:preview": "eas build --platform android --profile preview",
    "deploy:android:production": "eas build --platform android --profile production",
    "deploy:ios:preview": "eas build --platform ios --profile preview",
    "deploy:ota": "eas update --branch production"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/query-async-storage-persister": "^5.59.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.59.0",
    "@vis.gl/react-google-maps": "^1.4.0",
    "@vis.gl/react-maplibre": "^8.1.1",
    "expo": "^54.0.35",
    "expo-asset": "~12.0.13",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.17.0",
    "maplibre-gl": "^5.24.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-map-gl": "^8.1.1",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-maps": "^1.21.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/react-native": "^12.7.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.11",
    "fast-check": "^3.22.0",
    "jest": "^29.0.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-maps"
      ]
    }
  }
}
