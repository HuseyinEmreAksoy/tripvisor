# Client-side (bundled, safe to expose when properly restricted)
# Leave blank until you have real values. See docs/google-maps-setup.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maps JavaScript API key for the web bundle.
# MUST be referrer-restricted to your dev host (http://localhost:8081/*) and
# production domain in Google Cloud Console. See docs/google-maps-setup.md.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# Sentry DSN — leave blank to disable Sentry entirely (no network traffic,
# no init cost). See src/lib/sentry.ts.
EXPO_PUBLIC_SENTRY_DSN=

# Server-only values belong in Supabase secrets (or supabase/functions/.env
# for local dev), never in this file or the root .env at runtime.
# Edge Function env: copy GOOGLE_MAPS_SERVER_KEY into supabase/functions/.env
# (NOT .env at repo root). See docs/google-maps-setup.md.
# GOOGLE_MAPS_SERVER_KEY=server-only-key-with-no-referrer-restriction
# ALLOWED_ORIGINS=http://localhost:8081,https://your-host.com
