# Tripvisor — root .env template
# Copy to .env and fill in values for local development.
# .env is git-ignored; only this template is committed.

# -----------------------------------------------------------------------------
# Supabase (client-side, bundled into web + native)
# -----------------------------------------------------------------------------
# Local dev defaults to the values printed by `npx supabase start`.
# For production: paste the values from the Supabase Cloud dashboard
# (Project Settings -> API -> Project URL + anon/public key).
# anon key is safe to ship — RLS gates every read/write.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Google Maps Platform — WEB key only (Maps JavaScript API)
# -----------------------------------------------------------------------------
# This key is bundled into the web build. It MUST be referrer-restricted in
# Google Cloud Console (HTTP referrers) to:
#   - http://localhost:8081/*  (Expo dev server)
#   - https://<your-cloudflare-pages-domain>/*  (production)
# It MUST be API-restricted to "Maps JavaScript API" only — never grant it
# Places or Routes access. See docs/google-maps-setup.md.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# -----------------------------------------------------------------------------
# Public web origin (share + invite links)
# -----------------------------------------------------------------------------
# Origin used to build public share/invite links on iOS/Android so recipients
# can open them in any browser (and link previews work). Web ignores it and
# uses the page's own origin. If unset, native falls back to
# https://tripvisor.pages.dev. Baked in at build time; eas.json sets it for the
# preview + production profiles.
EXPO_PUBLIC_APP_URL=https://tripvisor.pages.dev

# -----------------------------------------------------------------------------
# Sentry (optional)
# -----------------------------------------------------------------------------
# Leave blank to disable Sentry entirely (no network traffic, no init cost).
# See src/lib/sentry.ts.
EXPO_PUBLIC_SENTRY_DSN=

# =============================================================================
# v2 — free-service config (see docs/v2/tech-stack.md). All FREE / $0 ceiling.
# =============================================================================

# -----------------------------------------------------------------------------
# Maps (web) — v2 free path
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_MAP_PROVIDER selects the WEB basemap: 'google' (legacy, Maps JS)
# or 'maplibre' (v2 free path, no key). Native always uses the Google SDK ($0
# render) until the New-Arch MapLibre swap (deferred — see docs/v2/risks).
EXPO_PUBLIC_MAP_PROVIDER=maplibre
# OpenFreeMap style URL — no key, no quota (https://openfreemap.org). Used when
# EXPO_PUBLIC_MAP_PROVIDER=maplibre.
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# -----------------------------------------------------------------------------
# Tier-1 offline sync (v2 S2.8 — Legend-State + expo-sqlite, src/sync/)
# -----------------------------------------------------------------------------
# '1' = the offline engine boots after sign-in (web: OPFS persistence on
# cross-origin-isolated browsers; Safari runs in-memory "Local-only mode").
# Baked in at build time. KILL SWITCH: the app_config row sync_tier1 wins over
# this — 'off' (any value other than 'on') disables it on shipped clients
# without a rebuild; absent row = this env default. See src/sync/flags.ts.
EXPO_PUBLIC_SYNC_TIER1=1

# -----------------------------------------------------------------------------
# Product analytics (optional, opt-in) — PostHog free tier
# -----------------------------------------------------------------------------
# Leave blank to disable all telemetry (zero network). Session replay stays OFF.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Server-only secrets — DO NOT put these here.
# -----------------------------------------------------------------------------
# These belong in supabase/functions/.env (local) or `npx supabase secrets set`
# (hosted). Never bundle a server key into the client. See docs/deployment.md,
# docs/google-maps-setup.md, docs/v2/tech-stack.md.
#
#   GOOGLE_MAPS_SERVER_KEY   Places + Routes HTTP (existing proxies + AI grounding)
#   GEMINI_API_KEY           AI itinerary/edits — Gemini 2.5 free tier (ai-itinerary fn)
#   GROQ_API_KEY             AI fallback — Groq gpt-oss-20b free tier
#   ROUTING_PROVIDER         'osrm' | 'ors' | 'google'  (distance-matrix/directions)
#   OSRM_BASE_URL            self-hosted OSRM endpoint (if ROUTING_PROVIDER=osrm)
#   ORS_API_KEY              openrouteservice free key (if ROUTING_PROVIDER=ors)
#   PHOTO_URL_SECRET         HMAC key for signed place-photo URLs (place-details +
#                            place-photo). Random, >= 32 bytes, e.g.
#                            `openssl rand -base64 32`. Rotating it invalidates
#                            issued photo URLs until the next place-details fetch.
#   OVERPASS_URLS            OPTIONAL. poi-recommend: comma-separated https Overpass
#                            interpreter URLs tried in order. Unset = overpass-api.de,
#                            overpass.private.coffee, maps.mail.ru (all keyless).
#   UPSTREAM_CONTACT         OPTIONAL. Contact (URL or mailbox) put in the User-Agent
#                            of fx-rates / poi-recommend calls to Frankfurter,
#                            Overpass and Wikipedia (their fair-use policies ask for
#                            one). Unset = https://tripvisor.pages.dev
#   # Open-Meteo (weather), Frankfurter (fx-rates), Overpass + Wikipedia
#   # (poi-recommend) need NO key.
#   # Resend (Auth SMTP) is configured in the Supabase dashboard, not here.
