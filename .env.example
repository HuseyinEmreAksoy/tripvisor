EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# Server-only values belong in Supabase secrets, not here:
# GOOGLE_MAPS_SERVER_KEY=server-only-unrestricted-key
# ALLOWED_ORIGINS=http://localhost:8081,https://your-host.com
